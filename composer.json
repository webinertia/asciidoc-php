{
    "name": "webware/asciidoc-php",
    "description": "A PHP port of the Asciidoctor toolchain that converts AsciiDoc source files to HTML5",
    "license": "MIT",
    "keywords": [
        "asciidoc",
        "asciidoctor",
        "converter",
        "html5",
        "documentation",
        "static-site"
    ],
    "authors": [
        {
            "name": "Joey (aka Tyrsson) Smith",
            "email": "jsmith@webinertia.net",
            "homepage": "https://github.com/webinertia/asciidoc-php",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/webinertia/asciidoc-php",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "infection/extension-installer": true
        }
    },
    "bin": [
        "bin/asciidoc-php"
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.0.0",
        "psr/log": "^3.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "Webware\\AsciidocPhp\\": "src/"
        }
    },
    "extra": {
        "resources-dir": "resources"
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTestAsset\\AsciidocPhp\\": "test/asset/",
            "WebwareTestIntegration\\AsciidocPhp\\": "test/integration/",
            "WebwareTest\\AsciidocPhp\\": "test/unit/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": [
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "upload-coverage": "coveralls -v",
        "render": "php bin/asciidoc-php -o test/results/full-document.html test/asset/integration/full-document.adoc",
        "render-embedded": "php bin/asciidoc-php -s -o test/results/full-document-embedded.html test/asset/integration/full-document.adoc",
        "render-preview": "php bin/render-preview test/asset/integration/full-document.adoc test/results/full-document-preview.html",
        "generate-corpus": "php bin/generate-benchmark-corpus",
        "benchmark": "php bin/benchmark",
        "benchmark-seeds": "php bin/benchmark --dir=test/benchmark/seeds",
        "benchmark-json": "php bin/benchmark --output=json",
        "benchmark-csv": "php bin/benchmark --output=csv"
    }
}
